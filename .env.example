# ==============================================================================
# SARDAAR JI DHABA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Application Settings
APP_NAME="Sardaar Ji Dhaba API"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Database Configuration
# Primary Production: MySQL (e.g. mysql+pymysql://username:password@localhost:3306/sardaarji_dhaba)
# Local Portability Fallback: sqlite:///./dhaba.db
DATABASE_URL=sqlite:///./dhaba.db

# Dhaba Business Details
DHABA_NAME="Sardaar Ji Dhaba"
DHABA_SUBTITLE="Prayagraj"
DHABA_PHONE="+91 8882897431"
DHABA_PHONE_RAW="918882897431"
DHABA_WHATSAPP_NUMBER="918882897431"
DHABA_EMAIL="sardaarjidhaba@gmail.com"
DHABA_ADDRESS="138C, Mahatma Gandhi Marg, near El Chico, Civil Lines, Prayagraj, Uttar Pradesh 211001"
GOOGLE_MAPS_URL="https://www.google.com/maps/place/?q=place_id:ChIJkQUGosDLmjkRF-KEtY-5EvA"
GOOGLE_MAPS_EMBED_URL="https://maps.google.com/maps?q=Sardaar+Ji+Dhaba+Prayagraj&output=embed"
INSTAGRAM_URL="https://www.instagram.com/sardaarjidhaba/"
FACEBOOK_URL="https://www.facebook.com/sardaarjidhaba/"
YOUTUBE_URL="https://www.youtube.com/@sardaarjidhaba"
BUSINESS_HOURS_DISPLAY="8:00 AM – 11:00 PM, All Days"

# Order Pricing & Charges
TAX_RATE=0.05
DELIVERY_FEE=30.0
FREE_DELIVERY_THRESHOLD=500.0
PACKAGING_FEE=15.0

# Google Sheets Live Operational Sync
# Option 1: File path to Google Cloud service account key JSON
GOOGLE_SHEETS_ENABLED=True
GOOGLE_SHEETS_CREDENTIALS_FILE="service_account.json"

# Option 2: Inline Google Cloud service account JSON string (for cloud deployments)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'

# Google Spreadsheet Configuration
# Optional: Specific Spreadsheet ID (if omitted, opens or creates by name)
# GOOGLE_SHEET_ID="your_google_sheet_id_here"
GOOGLE_SHEET_NAME="Sardaar Ji Dhaba - Live Orders"

# Frontend API URL (leave empty when Vite proxy is used)
VITE_API_URL=
